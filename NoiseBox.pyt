# -*- coding: utf-8 -*-
"""NoiseBox - ISO 9613-2 noise maps for ArcGIS Pro (Python toolbox).

This file only defines the tool dialogs. The work is done in the `noisebox` package next to it:
  noisebox/pipeline.py   what each tool does
  noisebox/engine.py     the calculation loops (parallel)
  noisebox/core_py/      the acoustics: Python translation of the MATLAB core, generated by matlab/nb_export_python.m
Keep the whole folder together.
"""
import importlib
import os
import sys

import arcpy

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

MODES = ["ISO 9613-2:2024 (default)",
         "ISO 9613-2:1996 (benchmark compatibility, 20 deg C / 70 % only)",
         "ISO 9613-2:2024 draft amendment (experimental)"]
WEIGHTINGS = ["Unweighted band level Lp", "A-weighted band level LpA"]
CAT_SET, CAT_LIM, CAT_OUT, CAT_ADV = "Calculation settings", "Allowed levels (optional)", "Outputs", "Advanced"


def _nb():
    """Import the helper package fresh, so edits and a new MATLAB export apply after a toolbox Refresh."""
    from noisebox import config, mrt, arcgis_io, outputs, engine, pipeline
    for m in (config, mrt, arcgis_io, outputs, engine, pipeline):
        importlib.reload(m)
    try:
        engine.core(reload=True)               # picks up a new MATLAB export
    except Exception:
        pass                                   # reported by the tools themselves
    return pipeline


class _ToolLog:
    def __init__(self):
        self._stepped = False

    def msg(self, s):
        arcpy.AddMessage(s)

    def warn(self, s):
        arcpy.AddWarning(s)

    def progress(self, done, total, text):
        try:
            if total and not self._stepped:
                arcpy.SetProgressor("step", text, 0, int(total), 1)
                self._stepped = True
            if self._stepped:
                arcpy.SetProgressorPosition(int(done))
            arcpy.SetProgressorLabel(text)
        except Exception:
            pass

    def cancelled(self):
        return arcpy.env.isCancelled


def _run(fn, *args):
    """Run a pipeline function; a user-facing NoiseBoxError becomes one clean tool error (no traceback)."""
    err = None
    try:
        return fn(*args)
    except Exception as e:  # noqa: BLE001
        if type(e).__name__ != "NoiseBoxError":
            raise
        err = str(e)
    finally:
        arcpy.ResetProgressor()
    raise arcpy.ExecuteError(err)


def _P(name, label, dtype, cat=None, required=False, default=None, values=None, geometry=None, deps=None,
       direction="Input"):
    p = arcpy.Parameter(displayName=label, name=name, datatype=dtype,
                        parameterType="Required" if required else "Optional", direction=direction)
    if default is not None:
        p.value = default
    if values is not None:
        p.filter.type = "ValueList"
        p.filter.list = list(values)
    if geometry:
        p.filter.list = [geometry]
    if deps:
        p.parameterDependencies = deps
    if cat:
        p.category = cat
    return p


def _by_name(parameters):
    return {p.name: p for p in parameters}


def _val(P, name):
    return P[name].valueAsText if name in P and P[name].value is not None else None


def _num(P, name):
    return P[name].value if name in P else None


def _bool(P, name, default=True):
    return bool(P[name].value) if name in P and P[name].value is not None else default


# ---------------------------------------------------------------- parameter groups (the same wording in every tool)
def _p_sources():
    return [_P("sources", "Sound sources (point layer with h_src and Lw_63 ... Lw_8000)", "GPFeatureLayer", required=True,
               geometry="Point")]


def _p_scene():
    return [
        _P("barriers", "Barriers and buildings (polygon layer with h_bar) - optional", "GPFeatureLayer", geometry="Polygon"),
        _P("dem", "Elevation raster (DEM, metres) - optional, flat ground if empty", "GPRasterLayer"),
    ]


def _p_settings():
    return [
        _P("G", "Ground factor G (0 = hard ground, 1 = porous ground)", "GPDouble", CAT_SET, default=0.5),
        _P("hr", "Receiver height (m above ground; also for receivers without their own height)", "GPDouble", CAT_SET,
           default=1.5),
        _P("T", "Air temperature (deg C)", "GPDouble", CAT_SET, default=15.0),
        _P("RH", "Relative humidity (%)", "GPDouble", CAT_SET, default=70.0),
        _P("mode", "Formula version", "GPString", CAT_SET, default=MODES[0], values=MODES),
    ]


def _p_limits():
    return [
        _P("overall", "Allowed overall level (dB(A)) - empty = none", "GPDouble", CAT_LIM),
        _P("band_limits", "Allowed octave-band levels in dB, 8 values 63 ... 8000 Hz, '-' = no limit (e.g. -,-,55,50,45,40,-,-)",
           "GPString", CAT_LIM),
        _P("weighting", "Compare the band limits with", "GPString", CAT_LIM, default=WEIGHTINGS[0], values=WEIGHTINGS),
    ]


def _p_advanced(with_barrier_fields=True):
    ps = [
        _P("h_field", "Source height field", "GPString", CAT_ADV, default="h_src"),
        _P("lw_prefix", "Source Lw field prefix (<prefix>63 ... <prefix>8000)", "GPString", CAT_ADV, default="Lw_"),
        _P("b_field", "Barrier height field", "GPString", CAT_ADV, default="h_bar"),
        _P("extra", "Extra inputs of the MATLAB core (name=value; name=value), e.g. C0=2; groundMethod=simplified",
           "GPString", CAT_ADV),
    ]
    return ps


def _p_gdb():
    return [_P("out_gdb", "Output geodatabase", "DEWorkspace", required=True)]


def _p_map():
    return [_P("add_map", "Add the results to the active map", "GPBoolean", CAT_OUT, default=True)]


def _scene_dict(P):
    d = {
        "sources": _val(P, "sources"), "h_field": _val(P, "h_field"), "lw_prefix": _val(P, "lw_prefix"),
        "barriers": _val(P, "barriers"), "b_field": _val(P, "b_field"), "dem": _val(P, "dem"),
        "G": _num(P, "G"), "hr": _num(P, "hr"), "T": _num(P, "T"), "RH": _num(P, "RH"), "mode": _val(P, "mode"),
        "overall": _num(P, "overall"), "band_limits": _val(P, "band_limits"), "weighting": _val(P, "weighting"),
        "extra": _val(P, "extra"), "out_gdb": _val(P, "out_gdb"), "run_name": _val(P, "run_name"),
        "add_map": _bool(P, "add_map"),
    }
    return d


# ---------------------------------------------------------------- dialog behaviour
def _fill_defaults(P):
    """Pre-fill the output geodatabase from the project."""
    if "out_gdb" in P and not P["out_gdb"].altered and not P["out_gdb"].value:
        try:
            P["out_gdb"].value = arcpy.mp.ArcGISProject("CURRENT").defaultGeodatabase
        except Exception:
            pass


def _check_layer(P, name, what, geom=None):
    if name in P and P[name].value:
        try:
            d = arcpy.Describe(P[name].value)
            sr = d.spatialReference
            if sr is None or sr.type != "Projected":
                P[name].setErrorMessage("%s must use a projected coordinate system in metres, not degrees. "
                                        "Project it first (Project tool)." % what)
            elif abs(sr.metersPerUnit - 1.0) > 1e-9:
                P[name].setErrorMessage("%s: the coordinate system must be in metres (it is in %s)." % (what, sr.linearUnitName))
            if geom and d.shapeType != geom:
                P[name].setErrorMessage("%s must be a %s layer." % (what, geom.lower()))
        except Exception:
            pass


def _check_fields(P, layer, names, what, hint):
    if layer in P and P[layer].value:
        try:
            have = {f.name.lower() for f in arcpy.ListFields(P[layer].value)}
        except Exception:
            return
        missing = [n for n in names if n.lower() not in have]
        if missing:
            shown = ", ".join(missing[:4]) + (" ..." if len(missing) > 4 else "")
            P[layer].setWarningMessage("%s has no field %s. %s" % (what, shown, hint))


def _messages(P, with_sources=True):
    _check_layer(P, "sources", "The source layer", "Point")
    _check_layer(P, "barriers", "The barrier layer", "Polygon")
    _check_layer(P, "area", "The calculation-area layer", "Polygon")
    _check_layer(P, "receivers", "The receiver layer", "Point")
    if with_sources and "sources" in P and P["sources"].value:
        hf = _val(P, "h_field") or "h_src"
        pre = _val(P, "lw_prefix") or "Lw_"
        _check_fields(P, "sources", [hf] + ["%s%d" % (pre, b) for b in (63, 125, 250, 500, 1000, 2000, 4000, 8000)],
                      "The source layer", "Run 'Create Input Layers' for a ready-made layer, or add the fields.")
    if "barriers" in P and P["barriers"].value:
        _check_fields(P, "barriers", [_val(P, "b_field") or "h_bar"], "The barrier layer",
                      "Add a number field with the height above ground in metres.")
    if "G" in P and P["G"].value is not None and not (0 <= P["G"].value <= 1):
        P["G"].setErrorMessage("G must be between 0 and 1.")
    if "RH" in P and P["RH"].value is not None and not (0 < P["RH"].value <= 100):
        P["RH"].setErrorMessage("Relative humidity must be between 0 and 100 %.")
    if "hr" in P and P["hr"].value is not None and P["hr"].value <= 0:
        P["hr"].setErrorMessage("Receiver height must be greater than 0.")
    if "cell" in P and P["cell"].value is not None and P["cell"].value <= 0:
        P["cell"].setErrorMessage("Cell size must be greater than 0.")
    if "band_limits" in P and P["band_limits"].value:
        try:
            _nb().parse_band_limits(P["band_limits"].valueAsText)
        except Exception as e:
            P["band_limits"].setErrorMessage(str(e))
    if "extra" in P and P["extra"].value:
        try:
            _nb().parse_extra(P["extra"].valueAsText)
        except Exception as e:
            P["extra"].setErrorMessage(str(e))


_AUTO = {"cell": None}


def _fill_auto_cell(P):
    """Show the automatic cell size in the dialog (the user may overwrite it). Same rule as the tool uses when empty:
    area layer, else extent, else the sources' bounding box + 300 m; about 150 cells across."""
    c = P["cell"]
    if c.value is not None and _AUTO["cell"] is not None and c.value != _AUTO["cell"]:
        return
    try:
        from noisebox import arcgis_io
        box = None
        if P["area"].value:
            e = arcpy.Describe(P["area"].value).extent
            box = (e.XMin, e.YMin, e.XMax, e.YMax)
        elif P["extent"].value is not None:
            e = P["extent"].value
            box = (e.XMin, e.YMin, e.XMax, e.YMax)
        elif P["sources"].value:
            e = arcpy.Describe(P["sources"].value).extent
            box = (e.XMin - 300.0, e.YMin - 300.0, e.XMax + 300.0, e.YMax + 300.0)
        if box is None:
            if c.value is not None:
                c.value = None
            _AUTO["cell"] = None
            return
        v = float(arcgis_io.auto_cell(box))
        if c.value != v:
            c.value = v
        _AUTO["cell"] = v
    except Exception:
        pass


# ---------------------------------------------------------------- toolbox
class Toolbox:
    def __init__(self):
        self.label = "NoiseBox"
        self.alias = "noisebox"
        self.tools = [CreateInputLayers, NoiseMap, NoiseAtReceivers, CompareNoiseMaps, CheckNoiseBox]


class CreateInputLayers:
    def __init__(self):
        self.label = "1 Create Input Layers"
        self.description = ("Creates empty Sources, Barriers, Receivers and Calculation-area layers with the fields the "
                            "other tools expect (h_src, Lw_63 ... Lw_8000, h_bar, h_rec) in a geodatabase and adds them "
                            "to the map, ready to draw or edit.")
        self.category = "Prepare"

    def getParameterInfo(self):
        return _p_gdb() + [
            _P("prefix", "Layer name prefix", "GPString", default="NB_"),
            _P("sr", "Coordinate system (projected, metres)", "GPSpatialReference"),
            _P("add_map", "Add the layers to the active map", "GPBoolean", default=True),
        ]

    def isLicensed(self):
        return True

    def updateParameters(self, parameters):
        P = _by_name(parameters)
        _fill_defaults(P)
        if not P["sr"].altered and not P["sr"].value:
            try:
                P["sr"].value = _nb().aio.default_template_sr()
            except Exception:
                pass

    def updateMessages(self, parameters):
        P = _by_name(parameters)
        sr = P["sr"].value
        if sr is not None:
            try:
                if sr.type != "Projected" or abs(sr.metersPerUnit - 1.0) > 1e-9:
                    P["sr"].setErrorMessage("Choose a projected coordinate system in metres.")
            except Exception:
                pass

    def execute(self, parameters, messages):
        pl = _nb()
        P = _by_name(parameters)
        p = {"out_gdb": _val(P, "out_gdb"), "prefix": _val(P, "prefix"), "sr": P["sr"].value,
             "add_map": _bool(P, "add_map")}
        _run(pl.create_inputs, p, _ToolLog())

    def postExecute(self, parameters):
        return


class NoiseMap:
    def __init__(self):
        self.label = "2 Noise Map (LAeq raster)"
        self.description = (
            "Calculates the A-weighted equivalent noise level LAeq (ISO 9613-2) on a grid from point sources, with "
            "optional barriers/buildings and terrain. Writes an LAeq raster, optional noise-band polygons, octave-band "
            "rasters, a pass/fail map against allowed levels and click-to-inspect cells with every level and "
            "attenuation. The acoustics run in the Python translation of the MATLAB core (see README).")
        self.category = "Calculate"

    def getParameterInfo(self):
        ps = _p_sources() + _p_gdb() + _p_scene()
        ps += [
            _P("area", "Calculation area (polygon layer) - optional", "GPFeatureLayer", geometry="Polygon"),
            _P("extent", "...or calculation area as an extent - optional", "GPExtent"),
            _P("cell", "Cell size (m) - filled in automatically (about 150 cells across); change it if you want", "GPDouble"),
        ]
        ps += _p_settings() + _p_limits()
        ps += [
            _P("run_name", "Run name (start of every output name; made unique automatically)", "GPString", CAT_OUT,
               default="NoiseRun"),
            _P("iso_step", "Noise-band polygons: class width (dB(A)); 0 = none", "GPDouble", CAT_OUT, default=5.0),
            _P("bands", "Also write one raster per octave band (unweighted Lp)", "GPBoolean", CAT_OUT, default=False),
            _P("detail", "Create click-to-inspect cells (all levels and attenuations)", "GPBoolean", CAT_OUT, default=True),
            _P("copy_inputs", "Save a copy of the inputs used", "GPBoolean", CAT_OUT, default=True),
        ]
        ps += _p_map() + _p_advanced()
        ps.append(_P("clip", "Leave cells outside the area polygon empty", "GPBoolean", CAT_ADV, default=True))
        return ps

    def isLicensed(self):
        return True

    def updateParameters(self, parameters):
        P = _by_name(parameters)
        _fill_defaults(P)
        _fill_auto_cell(P)

    def updateMessages(self, parameters):
        _messages(_by_name(parameters))

    def execute(self, parameters, messages):
        pl = _nb()
        P = _by_name(parameters)
        p = _scene_dict(P)
        p.update({"area": _val(P, "area"), "extent": P["extent"].value, "clip": _bool(P, "clip"),
                  "cell": _num(P, "cell"), "iso_step": _num(P, "iso_step"), "bands": _bool(P, "bands", False),
                  "detail": _bool(P, "detail"), "copy_inputs": _bool(P, "copy_inputs")})
        _run(pl.noise_map, p, _ToolLog())

    def postExecute(self, parameters):
        return


class NoiseAtReceivers:
    def __init__(self):
        self.label = "3 Noise at Receivers (points)"
        self.description = (
            "Levels at receiver points: LAeq, every octave band, allowed-level check and the attenuations per band, "
            "written as new fields on a copy of the receiver layer.")
        self.category = "Calculate"

    def getParameterInfo(self):
        ps = _p_sources() + _p_gdb()
        ps += [
            _P("receivers", "Receivers (point layer)", "GPFeatureLayer", required=True, geometry="Point"),
            _P("rh_field", "Receiver height field (m above ground) - empty = use the receiver height below", "GPString",
               default="h_rec"),
        ]
        ps += _p_scene() + _p_settings() + _p_limits()
        ps += [_P("run_name", "Run name", "GPString", CAT_OUT, default="Receivers")]
        ps += _p_map() + _p_advanced()
        return ps

    def isLicensed(self):
        return True

    def updateParameters(self, parameters):
        _fill_defaults(_by_name(parameters))

    def updateMessages(self, parameters):
        P = _by_name(parameters)
        _messages(P)

    def execute(self, parameters, messages):
        pl = _nb()
        P = _by_name(parameters)
        p = _scene_dict(P)
        rh = _val(P, "rh_field")
        if rh:
            try:
                have = {f.name.lower() for f in arcpy.ListFields(P["receivers"].value)}
                if rh.lower() not in have:
                    rh = None
            except Exception:
                pass
        p.update({"receivers": _val(P, "receivers"), "rh_field": rh})
        _run(pl.receivers, p, _ToolLog())

    def postExecute(self, parameters):
        return


class CompareNoiseMaps:
    def __init__(self):
        self.label = "4 Compare Noise Maps (scenario minus baseline)"
        self.description = ("Subtracts a baseline LAeq raster from a scenario LAeq raster (same grid) and reports how much "
                            "of the area became quieter or louder.")
        self.category = "Analyse"

    def getParameterInfo(self):
        return [
            _P("baseline", "Baseline LAeq raster", "GPRasterLayer", required=True),
            _P("scenario", "Scenario LAeq raster", "GPRasterLayer", required=True),
        ] + _p_gdb() + [
            _P("threshold", "Report the area changed by at least (dB)", "GPDouble", default=3.0),
            _P("run_name", "Run name", "GPString", default="Compare"),
            _P("add_map", "Add the result to the active map", "GPBoolean", default=True),
        ]

    def isLicensed(self):
        return True

    def updateParameters(self, parameters):
        _fill_defaults(_by_name(parameters))

    def updateMessages(self, parameters):
        return

    def execute(self, parameters, messages):
        pl = _nb()
        P = _by_name(parameters)
        p = {"baseline": _val(P, "baseline"), "scenario": _val(P, "scenario"), "out_gdb": _val(P, "out_gdb"),
             "threshold": _num(P, "threshold"), "run_name": _val(P, "run_name"), "add_map": _bool(P, "add_map")}
        _run(pl.compare, p, _ToolLog())

    def postExecute(self, parameters):
        return


class CheckNoiseBox:
    def __init__(self):
        self.label = "Check NoiseBox (Python core status)"
        self.description = ("Shows whether the Python core matches the MATLAB files in matlab/core, lists what changed "
                            "since the last export, and runs a self-test calculation. No MATLAB is needed.")
        self.category = "Maintenance"

    def getParameterInfo(self):
        return []

    def isLicensed(self):
        return True

    def updateParameters(self, parameters):
        return

    def updateMessages(self, parameters):
        return

    def execute(self, parameters, messages):
        pl = _nb()
        ok = pl.check(_ToolLog())
        if not ok:
            arcpy.AddWarning("The Python core is not up to date with the MATLAB files.")

    def postExecute(self, parameters):
        return
